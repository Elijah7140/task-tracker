{
  "name": "@task-tracker/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check:runtime": "electron dist/check-runtime.js",
