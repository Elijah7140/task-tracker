{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "types": ["node"],
    "lib": ["ES2024", "ESNext.Temporal"],
    "noEmit": true
  },
  "include": ["vite.config.ts", "test/**/*.ts"]
}
