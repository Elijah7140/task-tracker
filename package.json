{
  "name": "task-tracker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @task-tracker/desktop dev",
    "build": "pnpm -r run build",
    "test:node": "vp test run --project=!web-browser --project=!server-db --project=!server-rpc",
    "test:browser": "vp test run --project=web-browser",
    "test:server-db:electron": "node scripts/test-server-db-electron.mjs",
    "check:electron": "pnpm --filter @task-tracker/desktop check:runtime",
    "package:desktop": "pnpm run build && pnpm --filter @task-tracker/desktop run package",
    "test:desktop": "vp test run --config apps/desktop/vitest.config.ts"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "playwright": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": "26.13.0",
    "pnpm": "12.16.1"
  },
  "packageManager": "pnpm@12.16.1"
}
