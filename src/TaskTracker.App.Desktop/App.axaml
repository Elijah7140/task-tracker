<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TaskTracker.App.Desktop.App"
             RequestedThemeVariant="Default">
    <!-- "Default" follows the OS light/dark setting. -->
    <Application.Styles>
        <FluentTheme />
    </Application.Styles>
    <Application.Resources>
      <ResourceDictionary>
        <ResourceDictionary.ThemeDictionaries>
          <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="UrgencyApproachingBrush" Color="#FFF0BA" />
            <SolidColorBrush x:Key="UrgencyImmediateBrush" Color="#FFB8B2" />
            <SolidColorBrush x:Key="UrgencyForegroundBrush" Color="#181818" />
          </ResourceDictionary>
          <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="UrgencyApproachingBrush" Color="#5A4314" />
            <SolidColorBrush x:Key="UrgencyImmediateBrush" Color="#652A2A" />
            <SolidColorBrush x:Key="UrgencyForegroundBrush" Color="#FFFFFF" />
          </ResourceDictionary>
        </ResourceDictionary.ThemeDictionaries>
      </ResourceDictionary>
    </Application.Resources>
</Application>
