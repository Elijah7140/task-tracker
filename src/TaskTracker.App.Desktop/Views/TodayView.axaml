<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:TaskTracker.App.Desktop.Views"
             x:Class="TaskTracker.App.Desktop.Views.TodayView"
             x:CompileBindings="False">
  <Grid Margin="24" RowDefinitions="Auto,Auto,*" RowSpacing="12">
    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
      <Button Content="← Back" Command="{Binding BackCommand}" AutomationProperties.AutomationId="TodayBackButton" />
      <StackPanel Grid.Column="1" Spacing="2">
        <TextBlock Text="Today" FontSize="26" FontWeight="SemiBold" />
        <TextBlock Text="{Binding CompletedCount, StringFormat='{}{0} completed today'}" Opacity="0.75"
                   AutomationProperties.AutomationId="TodayCompletedCount" />
      </StackPanel>
    </Grid>
    <TextBlock Grid.Row="1" Text="{Binding Error}" TextWrapping="Wrap" Foreground="{DynamicResource AppDangerBrush}"
               IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
               AutomationProperties.AutomationId="TodayError" />
    <ScrollViewer Grid.Row="2">
      <StackPanel>
        <TextBlock Text="Nothing completed today yet." IsVisible="{Binding IsEmpty}"
                   HorizontalAlignment="Center" Margin="0,36" Opacity="0.75"
                   AutomationProperties.AutomationId="TodayEmptyState" />
        <ItemsControl ItemsSource="{Binding Projects}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Background="{DynamicResource AppCardBackgroundBrush}" CornerRadius="8"
                      Padding="16,12" Margin="0,0,0,12">
                <StackPanel Spacing="8">
                  <TextBlock Text="{Binding Name}" FontSize="19" FontWeight="SemiBold"
                             AutomationProperties.AutomationId="TodayProjectHeading" />
                  <ItemsControl ItemsSource="{Binding Areas}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <StackPanel Spacing="4" Margin="0,0,0,8">
                          <TextBlock Text="{Binding Path}" Opacity="0.75"
                                     AutomationProperties.AutomationId="TodayAreaPath" />
                          <ItemsControl ItemsSource="{Binding Rows}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <views:TodayBranchView />
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
