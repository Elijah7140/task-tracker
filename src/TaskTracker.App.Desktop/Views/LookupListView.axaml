<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TaskTracker.App.Desktop.Views.LookupListView"
             x:CompileBindings="False">
  <Border Classes="card">
    <StackPanel Spacing="12">
      <StackPanel Spacing="2">
        <TextBlock Text="{Binding Title}" Classes="cardTitle" />
        <TextBlock Text="Top of the list is the most important." Classes="caption" IsVisible="{Binding IsPriority}" />
        <TextBlock Text="Changes save immediately" Classes="caption" />
      </StackPanel>
      <ItemsControl ItemsSource="{Binding Active}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border AutomationProperties.Name="{Binding DisplayName}" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource AppCardBorderBrush}" Padding="2,3">
              <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="2">
                <DockPanel>
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="2"
                              IsVisible="{Binding $parent[UserControl].DataContext.IsPriority}">
                    <TextBox Width="82" Text="{Binding Number, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="Number" ToolTip.Tip="Priority number" AutomationProperties.AutomationId="PriorityNumberBox">
                      <TextBox.KeyBindings>
                        <KeyBinding Gesture="Enter" Command="{Binding $parent[UserControl].DataContext.SaveNumberCommand}" CommandParameter="{Binding}" />
                      </TextBox.KeyBindings>
                    </TextBox>
                    <Button Content="✓" Classes="subtle icon" ToolTip.Tip="Save priority number"
                            AutomationProperties.AutomationId="SavePriorityNumberButton"
                            Command="{Binding $parent[UserControl].DataContext.SaveNumberCommand}" CommandParameter="{Binding}" />
                  </StackPanel>
                  <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </DockPanel>
                <Button Grid.Column="1" Classes="subtle icon" ToolTip.Tip="Move up" AutomationProperties.AutomationId="LookupMoveUpButton"
                        Command="{Binding $parent[UserControl].DataContext.MoveUpCommand}" CommandParameter="{Binding}">
                  <PathIcon Data="{StaticResource IconMoveUp}" Width="14" Height="14" />
                </Button>
                <Button Grid.Column="2" Classes="subtle icon" ToolTip.Tip="Move down" AutomationProperties.AutomationId="LookupMoveDownButton"
                        Command="{Binding $parent[UserControl].DataContext.MoveDownCommand}" CommandParameter="{Binding}">
                  <PathIcon Data="{StaticResource IconMoveDown}" Width="14" Height="14" />
                </Button>
                <Button Grid.Column="3" Classes="subtle icon" ToolTip.Tip="Rename" AutomationProperties.AutomationId="LookupRenameButton"
                        Command="{Binding $parent[UserControl].DataContext.RenameCommand}" CommandParameter="{Binding}">
                  <PathIcon Data="{StaticResource IconRename}" Width="14" Height="14" />
                </Button>
                <Button Grid.Column="4" Classes="subtle icon" ToolTip.Tip="{Binding ArchiveTooltip}" AutomationProperties.AutomationId="LookupArchiveButton"
                        ToolTip.ShowOnDisabled="True" IsEnabled="{Binding CanArchive}"
                        Command="{Binding $parent[UserControl].DataContext.ArchiveCommand}" CommandParameter="{Binding}">
                  <PathIcon Data="{StaticResource IconArchive}" Width="14" Height="14" />
                </Button>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <StackPanel Spacing="4" IsVisible="{Binding HasArchived}">
        <TextBlock Text="Archived" Classes="caption" FontWeight="SemiBold" />
        <ItemsControl ItemsSource="{Binding Archived}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="*,Auto" Margin="2,0">
                <TextBlock Text="{Binding DisplayName}" Opacity="0.6" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <Button Grid.Column="1" Content="Restore" Classes="subtle" AutomationProperties.AutomationId="LookupRestoreButton"
                        Command="{Binding $parent[UserControl].DataContext.UnarchiveCommand}" CommandParameter="{Binding}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
        <TextBox Text="{Binding NewName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="New name" AutomationProperties.AutomationId="LookupNewNameBox">
          <TextBox.KeyBindings>
            <KeyBinding Gesture="Enter" Command="{Binding AddCommand}" />
          </TextBox.KeyBindings>
        </TextBox>
        <TextBox Grid.Column="1" Width="82" PlaceholderText="Number" IsVisible="{Binding IsPriority}"
                 Text="{Binding NewNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="NewPriorityNumberBox" />
        <ComboBox Grid.Column="1" ItemsSource="{Binding StatusKinds}" SelectedIndex="{Binding NewStatusKindIndex, Mode=TwoWay}"
                  IsVisible="{Binding IsStatus}" AutomationProperties.AutomationId="NewStatusKindBox" />
        <Button Grid.Column="2" Content="Add" Command="{Binding AddCommand}" AutomationProperties.AutomationId="LookupAddButton" />
      </Grid>
    </StackPanel>
  </Border>
</UserControl>
