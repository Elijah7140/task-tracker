<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TaskTracker.App.Desktop.Views.HomeView"
             x:CompileBindings="False">
  <UserControl.Styles>
    <Style Selector="WrapPanel.homeActions > Button">
      <Setter Property="Margin" Value="8,4,0,4" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Padding" Value="14,10" />
    </Style>
  </UserControl.Styles>
  <Grid RowDefinitions="Auto,*" Margin="40,32">
    <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,28" ColumnSpacing="8">
      <StackPanel Spacing="6" VerticalAlignment="Center">
        <TextBlock Text="Projects" FontSize="30" FontWeight="SemiBold" />
        <TextBlock Text="Choose a space to continue your work." Opacity="0.7" />
      </StackPanel>
      <WrapPanel Grid.Column="1" Classes="homeActions" HorizontalAlignment="Right" VerticalAlignment="Center">
        <Button Content="Import / Export ▾" AutomationProperties.AutomationId="ImportExportButton"
                IsVisible="{Binding Transfer, Converter={x:Static ObjectConverters.IsNotNull}}"
                IsEnabled="{Binding Transfer.IsIdle}">
          <Button.Flyout>
            <MenuFlyout Placement="BottomEdgeAlignedRight">
              <MenuItem Header="Export everything (JSON)…" Command="{Binding Transfer.ExportAllCommand}"
                        AutomationProperties.AutomationId="ExportAllMenuItem" />
              <MenuItem Header="Export project (JSON)…" Command="{Binding Transfer.ExportProjectJsonCommand}"
                        AutomationProperties.AutomationId="ExportProjectJsonMenuItem" />
              <MenuItem Header="Export project (CSV)…" Command="{Binding Transfer.ExportProjectCsvCommand}"
                        AutomationProperties.AutomationId="ExportProjectCsvMenuItem" />
              <Separator />
              <MenuItem Header="Import JSON…" Command="{Binding Transfer.ImportJsonCommand}"
                        AutomationProperties.AutomationId="ImportJsonMenuItem" />
              <MenuItem Header="Import CSV into project…" Command="{Binding Transfer.ImportCsvCommand}"
                        AutomationProperties.AutomationId="ImportCsvMenuItem" />
            </MenuFlyout>
          </Button.Flyout>
        </Button>
        <Button Content="+ New project" Command="{Binding CreateCommand}" AutomationProperties.AutomationId="NewProjectButton" />
      </WrapPanel>
    </Grid>
    <ScrollViewer Grid.Row="1">
      <StackPanel Spacing="12">
        <ProgressBar IsIndeterminate="True" IsVisible="{Binding Transfer.IsWorking}"
                     AutomationProperties.AutomationId="TransferBusyBar" />
        <TextBlock Text="{Binding Transfer.StatusMessage}" TextWrapping="Wrap" Opacity="0.8"
                   IsVisible="{Binding Transfer.StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                   AutomationProperties.AutomationId="TransferStatusText" />
        <TextBlock Text="No projects yet. Create one to get started." IsVisible="{Binding IsEmpty}"
                   FontSize="16" Opacity="0.7" Margin="0,32" HorizontalAlignment="Center" />
        <ItemsControl ItemsSource="{Binding Cards}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border BorderThickness="1" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                      Background="Transparent"
                      CornerRadius="10" Padding="20" Margin="0,0,0,12" Focusable="True"
                      PointerPressed="OnCardPointerPressed" KeyDown="OnCardKeyDown" AutomationProperties.AutomationId="ProjectCard">
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                  <TextBlock Text="{Binding Name}" FontSize="19" FontWeight="SemiBold" />
                  <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="18" Margin="0,8,0,0">
                    <TextBlock Text="{Binding OpenCount, StringFormat='{}{0} open'}" Opacity="0.7" />
                    <TextBlock Text="{Binding OverdueCount, StringFormat='{}{0} overdue'}" Opacity="0.7" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Grid.RowSpan="2" Orientation="Horizontal" Spacing="8"
                              VerticalAlignment="Center">
                    <Button Content="Open" Classes="accent" Command="{Binding $parent[UserControl].DataContext.OpenCommand}" AutomationProperties.AutomationId="OpenProjectButton"
                            CommandParameter="{Binding}" />
                    <Button Content="Rename" Classes="subtle" Command="{Binding $parent[UserControl].DataContext.RenameCommand}" AutomationProperties.AutomationId="RenameProjectButton"
                            CommandParameter="{Binding}" />
                    <Button Content="Settings" Classes="subtle" Command="{Binding $parent[UserControl].DataContext.ProjectSettingsCommand}" AutomationProperties.AutomationId="ProjectSettingsButton"
                            CommandParameter="{Binding}" />
                    <Button Content="Delete" Classes="subtle" Command="{Binding $parent[UserControl].DataContext.DeleteCommand}" AutomationProperties.AutomationId="DeleteProjectButton"
                            CommandParameter="{Binding}" />
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <StackPanel Spacing="8" Margin="0,12,0,0" IsVisible="{Binding SavedSearches.HasItems}"
                    AutomationProperties.AutomationId="SavedSearchesSection">
          <TextBlock Text="Saved searches" FontSize="22" FontWeight="SemiBold" />
          <TextBlock Text="{Binding SavedSearches.Error}" Foreground="{DynamicResource AppDangerBrush}"
                     TextWrapping="Wrap" AutomationProperties.AutomationId="HomeSavedSearchErrorText" />
          <ItemsControl ItemsSource="{Binding SavedSearches.Items}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                  <Button Content="{Binding Name}" HorizontalAlignment="Left"
                          Command="{Binding $parent[UserControl].DataContext.SavedSearches.OpenCommand}"
                          CommandParameter="{Binding}" AutomationProperties.AutomationId="SavedSearchLink"
                          AutomationProperties.Name="{Binding Name}" />
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Content="Rename" Classes="subtle"
                            Command="{Binding $parent[UserControl].DataContext.SavedSearches.RenameCommand}"
                            CommandParameter="{Binding}" AutomationProperties.AutomationId="RenameSavedSearchLinkButton" />
                    <Button Content="Delete" Classes="subtle"
                            Command="{Binding $parent[UserControl].DataContext.SavedSearches.DeleteCommand}"
                            CommandParameter="{Binding}" AutomationProperties.AutomationId="DeleteSavedSearchLinkButton" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
