<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TaskTracker.Presentation.ViewModels"
             x:Class="TaskTracker.App.Desktop.Views.RemindersView"
             x:DataType="vm:RemindersViewModel"
             AutomationProperties.AutomationId="RemindersPanel">
  <Border Classes="card" Width="460" MaxHeight="440" BoxShadow="0 4 15 0 #33000000">
    <Grid RowDefinitions="Auto,*" RowSpacing="12">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="Reminders" Classes="cardTitle" VerticalAlignment="Center" />
        <Button Grid.Column="1" Content="✕" Classes="subtle icon" Command="{Binding ToggleCommand}"
                AutomationProperties.Name="Close reminders" AutomationProperties.AutomationId="CloseRemindersPanel" />
      </Grid>
      <TextBlock Grid.Row="1" Classes="caption" Text="No reminders" IsVisible="{Binding !HasReminders}" />
      <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
        <ItemsControl ItemsSource="{Binding Rows}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ReminderRowViewModel">
              <Border BorderBrush="{DynamicResource AppCardBorderBrush}" BorderThickness="0,1,0,0" Padding="0,10">
                <StackPanel Spacing="5">
                  <TextBlock Text="{Binding Entry.Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Entry.ProjectName}" Classes="caption" TextWrapping="Wrap" />
                  <WrapPanel>
                    <Button Content="Open" Command="{Binding OpenCommand}" Classes="subtle" AutomationProperties.AutomationId="ReminderOpen" />
                    <Button Content="Mark complete" Command="{Binding CompleteCommand}" Classes="subtle" AutomationProperties.AutomationId="ReminderComplete" />
                    <Button Content="Snooze ▾" Classes="subtle" AutomationProperties.AutomationId="ReminderSnooze">
                      <Button.Flyout>
                        <MenuFlyout>
                          <MenuItem Header="10 minutes" Command="{Binding SnoozeTenMinutesCommand}" AutomationProperties.AutomationId="ReminderSnoozeTenMinutes" />
                          <MenuItem Header="1 hour" Command="{Binding SnoozeOneHourCommand}" AutomationProperties.AutomationId="ReminderSnoozeOneHour" />
                          <MenuItem Header="Tomorrow" Command="{Binding SnoozeTomorrowCommand}" AutomationProperties.AutomationId="ReminderSnoozeTomorrow" />
                        </MenuFlyout>
                      </Button.Flyout>
                    </Button>
                    <Button Content="Dismiss" Command="{Binding DismissCommand}" Classes="subtle" AutomationProperties.AutomationId="ReminderDismiss" />
                  </WrapPanel>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Grid>
  </Border>
</UserControl>
