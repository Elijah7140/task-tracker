<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:TaskTracker.App.Desktop.Views"
             x:Class="TaskTracker.App.Desktop.Views.FieldManagerView"
             x:CompileBindings="False">
  <UserControl.Styles>
    <Style Selector="TextBlock.archived">
      <Setter Property="Opacity" Value="0.6" />
    </Style>
  </UserControl.Styles>
  <Border Classes="card">
    <StackPanel Spacing="12">
      <StackPanel Spacing="2">
        <TextBlock Text="{Binding Title}" Classes="cardTitle" />
        <TextBlock Text="{Binding Description}" Classes="caption" />
      </StackPanel>
      <CheckBox Content="Show archived" IsChecked="{Binding ShowArchived, Mode=OneWay}"
                Command="{Binding SetShowArchivedCommand}" CommandParameter="{Binding $self.IsChecked}"
                AutomationProperties.AutomationId="FieldShowArchivedCheckBox" />
      <ItemsControl ItemsSource="{Binding Rows}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource AppCardBorderBrush}" Padding="2,4">
              <StackPanel Spacing="4">
                <Grid ColumnDefinitions="*,130,Auto,Auto,Auto,Auto" ColumnSpacing="4">
                  <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" Classes.archived="{Binding IsArchived}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="(archived)" Classes="caption" IsVisible="{Binding IsArchived}" VerticalAlignment="Center" />
                  </StackPanel>
                  <views:CommitOnChoiceComboBox Grid.Column="1" ItemsSource="{Binding Types}" CommittedItem="{Binding SelectedType, Mode=TwoWay}"
                            IsEnabled="{Binding !IsArchived}" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="FieldTypeBox" />
                  <Button Grid.Column="2" Classes="subtle icon" ToolTip.Tip="Move up" AutomationProperties.AutomationId="FieldMoveUpButton"
                          Command="{Binding $parent[UserControl].DataContext.MoveUpCommand}" CommandParameter="{Binding}">
                    <PathIcon Data="{StaticResource IconMoveUp}" Width="14" Height="14" />
                  </Button>
                  <Button Grid.Column="3" Classes="subtle icon" ToolTip.Tip="Move down" AutomationProperties.AutomationId="FieldMoveDownButton"
                          Command="{Binding $parent[UserControl].DataContext.MoveDownCommand}" CommandParameter="{Binding}">
                    <PathIcon Data="{StaticResource IconMoveDown}" Width="14" Height="14" />
                  </Button>
                  <Button Grid.Column="4" Classes="subtle icon" ToolTip.Tip="Rename" AutomationProperties.AutomationId="FieldRenameButton"
                          Command="{Binding $parent[UserControl].DataContext.RenameCommand}" CommandParameter="{Binding}">
                    <PathIcon Data="{StaticResource IconRename}" Width="14" Height="14" />
                  </Button>
                  <Button Grid.Column="5" Classes="subtle icon" ToolTip.Tip="Archive" AutomationProperties.AutomationId="FieldArchiveButton"
                          IsVisible="{Binding !IsArchived}"
                          Command="{Binding $parent[UserControl].DataContext.ArchiveCommand}" CommandParameter="{Binding}">
                    <PathIcon Data="{StaticResource IconArchive}" Width="14" Height="14" />
                  </Button>
                  <Button Grid.Column="5" Classes="subtle icon" ToolTip.Tip="Restore" AutomationProperties.Name="Restore" AutomationProperties.AutomationId="FieldRestoreButton"
                          IsVisible="{Binding IsArchived}"
                          Command="{Binding $parent[UserControl].DataContext.UnarchiveCommand}" CommandParameter="{Binding}">
                    <PathIcon Data="{StaticResource IconUnarchive}" Width="14" Height="14" />
                  </Button>
                </Grid>
                <StackPanel IsVisible="{Binding IsChoice}" Margin="16,0,0,0">
                  <Expander DataContext="{Binding Choices}" Header="{Binding Header}" IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                            AutomationProperties.AutomationId="FieldChoicesExpander">
                    <StackPanel Spacing="6">
                      <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="2" Margin="0,1">
                              <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Label}" Classes.archived="{Binding IsArchived}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="(archived)" Classes="caption" IsVisible="{Binding IsArchived}" VerticalAlignment="Center" />
                              </StackPanel>
                              <Button Grid.Column="1" Classes="subtle icon" ToolTip.Tip="Move choice up" AutomationProperties.AutomationId="ChoiceMoveUpButton"
                                      Command="{Binding $parent[Expander].DataContext.MoveUpCommand}" CommandParameter="{Binding}">
                                <PathIcon Data="{StaticResource IconMoveUp}" Width="14" Height="14" />
                              </Button>
                              <Button Grid.Column="2" Classes="subtle icon" ToolTip.Tip="Move choice down" AutomationProperties.AutomationId="ChoiceMoveDownButton"
                                      Command="{Binding $parent[Expander].DataContext.MoveDownCommand}" CommandParameter="{Binding}">
                                <PathIcon Data="{StaticResource IconMoveDown}" Width="14" Height="14" />
                              </Button>
                              <Button Grid.Column="3" Classes="subtle icon" ToolTip.Tip="Rename choice" AutomationProperties.AutomationId="ChoiceRenameButton"
                                      Command="{Binding $parent[Expander].DataContext.RenameCommand}" CommandParameter="{Binding}">
                                <PathIcon Data="{StaticResource IconRename}" Width="14" Height="14" />
                              </Button>
                              <Button Grid.Column="4" Classes="subtle icon" ToolTip.Tip="Archive choice" AutomationProperties.AutomationId="ChoiceArchiveButton"
                                      IsVisible="{Binding !IsArchived}"
                                      Command="{Binding $parent[Expander].DataContext.ArchiveCommand}" CommandParameter="{Binding}">
                                <PathIcon Data="{StaticResource IconArchive}" Width="14" Height="14" />
                              </Button>
                              <Button Grid.Column="4" Classes="subtle icon" ToolTip.Tip="Restore choice" AutomationProperties.Name="Restore" AutomationProperties.AutomationId="ChoiceRestoreButton"
                                      IsVisible="{Binding IsArchived}"
                                      Command="{Binding $parent[Expander].DataContext.UnarchiveCommand}" CommandParameter="{Binding}">
                                  <PathIcon Data="{StaticResource IconUnarchive}" Width="14" Height="14" />
                              </Button>
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding CanAdd}">
                        <TextBox Text="{Binding NewLabel, Mode=TwoWay}" PlaceholderText="New choice"
                                 AutomationProperties.AutomationId="ChoiceNewLabelBox">
                          <TextBox.KeyBindings>
                            <KeyBinding Gesture="Enter" Command="{Binding AddCommand}" />
                          </TextBox.KeyBindings>
                        </TextBox>
                        <Button Grid.Column="1" Content="Add choice" Command="{Binding AddCommand}"
                                AutomationProperties.AutomationId="ChoiceAddButton" />
                      </Grid>
                    </StackPanel>
                  </Expander>
                </StackPanel>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <Grid ColumnDefinitions="*,130,Auto" ColumnSpacing="8">
        <TextBox Text="{Binding NewName, Mode=TwoWay}" PlaceholderText="New field name"
                 AutomationProperties.AutomationId="FieldNewNameBox">
          <TextBox.KeyBindings>
            <KeyBinding Gesture="Enter" Command="{Binding AddCommand}" />
          </TextBox.KeyBindings>
        </TextBox>
        <ComboBox Grid.Column="1" ItemsSource="{Binding Types}" SelectedItem="{Binding NewType, Mode=TwoWay}"
                  HorizontalAlignment="Stretch" AutomationProperties.AutomationId="FieldNewTypeBox" />
        <Button Grid.Column="2" Content="Add field" Command="{Binding AddCommand}"
                AutomationProperties.AutomationId="FieldAddButton" />
      </Grid>
      <StackPanel IsVisible="{Binding HasInherited}" Spacing="4">
        <TextBlock Text="Global fields (inherited)" FontWeight="SemiBold" />
        <TextBlock Text="Available in this project. Manage them in App Settings." Classes="caption" />
        <ItemsControl ItemsSource="{Binding Inherited}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="*,130,132" ColumnSpacing="4" Margin="2,2">
                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Text="{Binding DataType}" Classes="caption" VerticalAlignment="Center" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
