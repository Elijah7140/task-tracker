<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:TaskTracker.App.Desktop.Converters"
             xmlns:views="clr-namespace:TaskTracker.App.Desktop.Views"
             x:Class="TaskTracker.App.Desktop.Views.ProjectWorkspaceView"
             x:CompileBindings="False" KeyDown="OnFocusKeyDown">
  <UserControl.KeyBindings>
    <KeyBinding Gesture="Ctrl+Shift+N" Command="{Binding AddSubItemCommand}" />
    <KeyBinding Gesture="Alt+Up" Command="{Binding MoveUpCommand}" />
    <KeyBinding Gesture="Alt+Down" Command="{Binding MoveDownCommand}" />
  </UserControl.KeyBindings>
  <UserControl.Styles>
    <Style Selector="Button.overdue">
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="Button.hyperlink">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource SystemAccentColor}" />
    </Style>
  </UserControl.Styles>
  <UserControl.Resources>
    <converters:UrgencyBrushConverter x:Key="UrgencyBrush" />
    <converters:UrgencyForegroundConverter x:Key="UrgencyForeground" />
  </UserControl.Resources>
  <Grid RowDefinitions="Auto,*">
    <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
            Padding="22,16">
      <ItemsControl ItemsSource="{Binding Breadcrumbs}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6" /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="›" VerticalAlignment="Center" Opacity="0.55" IsVisible="{Binding HasSeparator}" />
              <Button Content="{Binding Name}" Command="{Binding NavigateCommand}" Padding="2,3"
                      Classes="hyperlink" IsVisible="{Binding !IsCurrent}" />
              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"
                         IsVisible="{Binding IsCurrent}" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Border>
    <Grid Grid.Row="1" ColumnDefinitions="230,*,310">
      <Border BorderThickness="0,0,1,0" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
              Padding="16,22">
        <Grid RowDefinitions="Auto,*" RowSpacing="16">
          <TextBlock Text="FOLDERS" FontSize="12" FontWeight="SemiBold" Opacity="0.7" Margin="8,0" />
          <TreeView Grid.Row="1" ItemsSource="{Binding FolderRoots}" HorizontalAlignment="Stretch"
                    SelectionChanged="OnFolderSelectionChanged">
            <TreeView.Styles>
              <Style Selector="TreeViewItem">
                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
              </Style>
            </TreeView.Styles>
            <TreeView.ItemTemplate>
              <TreeDataTemplate ItemsSource="{Binding Children}">
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Padding="4,6">
                  <TextBlock.ContextMenu>
                    <ContextMenu>
                      <MenuItem Header="New folder" Command="{Binding NewFolderCommand}" />
                      <MenuItem Header="Rename" Command="{Binding RenameCommand}" IsVisible="{Binding !IsRoot}" />
                      <MenuItem Header="Move" Command="{Binding MoveCommand}" IsVisible="{Binding !IsRoot}" />
                      <MenuItem Header="Delete" Command="{Binding DeleteCommand}" IsVisible="{Binding !IsRoot}" />
                    </ContextMenu>
                  </TextBlock.ContextMenu>
                </TextBlock>
              </TreeDataTemplate>
            </TreeView.ItemTemplate>
          </TreeView>
        </Grid>
      </Border>
      <Grid Grid.Column="1" Margin="24,20" RowDefinitions="Auto,Auto,*" RowSpacing="14">
        <TextBlock Text="{Binding SelectedAreaName}" FontSize="27" FontWeight="SemiBold" />
        <TextBox x:Name="QuickAddBox" Grid.Row="1" PlaceholderText="Add an item and press Enter"
                 Text="{Binding QuickAddTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
          <TextBox.KeyBindings>
            <KeyBinding Gesture="Enter" Command="{Binding QuickAddCommand}" />
          </TextBox.KeyBindings>
        </TextBox>
        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled">
          <ScrollViewer.KeyBindings>
            <KeyBinding Gesture="Space" Command="{Binding ToggleSelectedCommand}" />
            <KeyBinding Gesture="Delete" Command="{Binding DeleteItemCommand}" />
          </ScrollViewer.KeyBindings>
          <StackPanel Spacing="12">
            <ItemsControl ItemsSource="{Binding OpenItems}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <views:ItemBranchView />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Expander Header="{Binding CompletedLabel}" IsExpanded="{Binding IsCompletedExpanded, Mode=TwoWay}"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
              <ItemsControl ItemsSource="{Binding CompletedItems}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <views:ItemBranchView />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Expander>
          </StackPanel>
        </ScrollViewer>
      </Grid>
      <Border Grid.Column="2" BorderThickness="1,0,0,0"
              BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" Padding="18,20">
        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
          <TextBlock Text="DETAILS" FontSize="12" FontWeight="SemiBold" Opacity="0.6" />
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Visible"
                        HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="8" Margin="0,0,8,0">
              <TextBlock Text="Select an item to see its details." IsVisible="{Binding !HasEditor}"
                         TextWrapping="Wrap" Opacity="0.7" />
              <StackPanel DataContext="{Binding Editor}"
                          IsVisible="{Binding $parent[UserControl].DataContext.HasEditor}" Spacing="8">
              <TextBlock Text="Title" />
              <TextBox x:Name="EditorTitleBox" Text="{Binding Title, Mode=TwoWay}" />
              <TextBlock Text="Description" />
              <TextBox Text="{Binding Description, Mode=TwoWay}" AcceptsReturn="True" MinHeight="80"
                       TextWrapping="Wrap" />
              <TextBlock Text="Ticket number" />
              <TextBox Text="{Binding TicketNumber, Mode=TwoWay}" />
              <TextBlock Text="Type" />
              <TextBlock Text="{Binding ArchivedTypeName}" IsVisible="{Binding HasArchivedType}" Opacity="0.7" />
              <ComboBox ItemsSource="{Binding $parent[UserControl].DataContext.TypeOptions}"
                        SelectedItem="{Binding SelectedTypeOption, Mode=TwoWay}"
                        DisplayMemberBinding="{Binding Name}" HorizontalAlignment="Stretch" />
              <TextBlock Text="Priority" />
              <TextBlock Text="{Binding ArchivedPriorityName}" IsVisible="{Binding HasArchivedPriority}" Opacity="0.7" />
              <ComboBox ItemsSource="{Binding $parent[UserControl].DataContext.PriorityOptions}"
                        SelectedItem="{Binding SelectedPriorityOption, Mode=TwoWay}"
                        DisplayMemberBinding="{Binding Name}" HorizontalAlignment="Stretch" />
              <TextBlock Text="Due date" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                <CalendarDatePicker SelectedDate="{Binding DueDatePickerDate, Mode=TwoWay}"
                                    HorizontalAlignment="Stretch" />
                <Button Grid.Column="1" Content="Clear" Command="{Binding ClearDueDateCommand}" />
              </Grid>
              <TextBlock Text="Due time" />
              <StackPanel Spacing="4">
                <TimePicker SelectedTime="{Binding DueTimePickerTime, Mode=TwoWay}"
                            HorizontalAlignment="Stretch" />
                <Button Content="Clear time" Command="{Binding ClearDueTimeCommand}"
                        HorizontalAlignment="Right" />
              </StackPanel>
              <TextBlock Text="Scheduled start" />
              <StackPanel Spacing="4">
                <CalendarDatePicker SelectedDate="{Binding StartPickerDate, Mode=TwoWay}" />
                <TimePicker SelectedTime="{Binding StartPickerTime, Mode=TwoWay}"
                            HorizontalAlignment="Stretch" />
                <Button Content="Clear start" Command="{Binding ClearStartCommand}"
                        HorizontalAlignment="Right" />
              </StackPanel>
              <TextBlock Text="Scheduled end" />
              <StackPanel Spacing="4">
                <CalendarDatePicker SelectedDate="{Binding EndPickerDate, Mode=TwoWay}" />
                <TimePicker SelectedTime="{Binding EndPickerTime, Mode=TwoWay}"
                            HorizontalAlignment="Stretch" />
                <Button Content="Clear end" Command="{Binding ClearEndCommand}"
                        HorizontalAlignment="Right" />
              </StackPanel>
              <Button Content="Add sub-item" Command="{Binding $parent[UserControl].DataContext.AddSubItemCommand}" />
              <ItemsControl ItemsSource="{Binding $parent[UserControl].DataContext.SelectedSubItems}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Content="{Binding Title}" Command="{Binding SelectCommand}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Button Content="Delete item" Command="{Binding $parent[UserControl].DataContext.DeleteItemCommand}" />
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
          <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8"
                      IsVisible="{Binding HasEditor}">
            <Button Content="Save" Command="{Binding SaveCommand}" />
            <Button Content="Revert" Command="{Binding RevertCommand}" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
