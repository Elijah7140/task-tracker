<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:TaskTracker.App.Desktop.Converters"
             xmlns:views="clr-namespace:TaskTracker.App.Desktop.Views"
             x:Class="TaskTracker.App.Desktop.Views.ProjectWorkspaceView"
             x:CompileBindings="False" KeyDown="OnFocusKeyDown">
  <UserControl.KeyBindings>
    <KeyBinding Gesture="Ctrl+Shift+N" Command="{Binding AddSubItemCommand}" />
    <KeyBinding Gesture="Alt+Up" Command="{Binding MoveUpCommand}" />
    <KeyBinding Gesture="Alt+Down" Command="{Binding MoveDownCommand}" />
  </UserControl.KeyBindings>
  <UserControl.Styles>
    <Style Selector="Button.overdue">
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="Button.hyperlink">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource SystemAccentColor}" />
    </Style>
    <Style Selector="Button.tab">
      <Setter Property="Padding" Value="8,2" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
    <Style Selector="Button.tab.activeTab">
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{DynamicResource SystemAccentColor}" />
    </Style>
    <!-- A transparent background makes the whole header width a drop target. -->
    <Style Selector="Border.groupHeader">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.groupHeader.dropGroup">
      <Setter Property="Background">
        <SolidColorBrush Color="{DynamicResource SystemAccentColor}" Opacity="0.25" />
      </Setter>
    </Style>
    <Style Selector="ScrollViewer.dropRoot">
      <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
      <Setter Property="BorderThickness" Value="0,0,0,3" />
    </Style>
  </UserControl.Styles>
  <UserControl.Resources>
    <converters:UrgencyBrushConverter x:Key="UrgencyBrush" />
    <converters:UrgencyForegroundConverter x:Key="UrgencyForeground" />
  </UserControl.Resources>
  <Grid RowDefinitions="Auto,*">
    <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
            Padding="22,16">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="12">
      <ItemsControl ItemsSource="{Binding Breadcrumbs}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6" /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="›" VerticalAlignment="Center" Opacity="0.55" IsVisible="{Binding HasSeparator}" />
              <Button Content="{Binding Name}" Command="{Binding NavigateCommand}" Padding="2,3" AutomationProperties.AutomationId="BreadcrumbButton"
                      Classes="hyperlink" IsVisible="{Binding !IsCurrent}" />
              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"
                         IsVisible="{Binding IsCurrent}" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <Button Grid.Column="1" Content="Undo" Command="{Binding Undo.UndoCommand}" ToolTip.Tip="{Binding Undo.UndoTooltip}" IsVisible="{Binding HasUndo}" Classes="subtle" AutomationProperties.AutomationId="WorkspaceUndoButton" />
      <Button Grid.Column="2" Content="Redo" Command="{Binding Undo.RedoCommand}" ToolTip.Tip="{Binding Undo.RedoTooltip}" IsVisible="{Binding HasUndo}" Classes="subtle" AutomationProperties.AutomationId="WorkspaceRedoButton" />
      <Button Grid.Column="3" Content="⚙ Settings" Command="{Binding SettingsCommand}" Classes="subtle" AutomationProperties.AutomationId="WorkspaceAppSettingsButton" />
      <Button Grid.Column="4" Content="Project settings" Command="{Binding ProjectSettingsCommand}" Classes="subtle" AutomationProperties.AutomationId="WorkspaceProjectSettingsButton" />
      <Button Grid.Column="5" Content="Search" Command="{Binding SearchCommand}" Classes="subtle" AutomationProperties.AutomationId="WorkspaceSearchButton" />
      <Button Grid.Column="6" Content="Calendar" Command="{Binding CalendarCommand}" Classes="subtle" AutomationProperties.AutomationId="WorkspaceCalendarButton" />
      <Button Grid.Column="7" Content="Trash" Command="{Binding TrashCommand}" Classes="subtle" AutomationProperties.AutomationId="WorkspaceTrashButton" />
      </Grid>
    </Border>
    <Grid Grid.Row="1" ColumnDefinitions="230,*,320">
      <Border BorderThickness="0,0,1,0" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
              Padding="16,22">
        <Grid RowDefinitions="Auto,*" RowSpacing="16">
          <TextBlock Text="FOLDERS" FontSize="12" FontWeight="SemiBold" Opacity="0.7" Margin="8,0" />
          <TreeView Grid.Row="1" ItemsSource="{Binding FolderRoots}" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="FolderTree"
                    SelectionChanged="OnFolderSelectionChanged">
            <TreeView.Styles>
              <Style Selector="TreeViewItem">
                <Setter Property="AutomationProperties.AutomationId" Value="FolderTreeItem" />
                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="ContextMenu">
                  <ContextMenu>
                    <MenuItem Header="New folder" Command="{Binding NewFolderCommand}" AutomationProperties.AutomationId="NewFolderMenuItem" />
                    <MenuItem Header="Rename" Command="{Binding RenameCommand}" IsVisible="{Binding !IsRoot}" AutomationProperties.AutomationId="RenameFolderMenuItem" />
                    <MenuItem Header="Move" Command="{Binding MoveCommand}" IsVisible="{Binding !IsRoot}" AutomationProperties.AutomationId="MoveFolderMenuItem" />
                    <MenuItem Header="Delete" Command="{Binding DeleteCommand}" IsVisible="{Binding !IsRoot}" AutomationProperties.AutomationId="DeleteFolderMenuItem" />
                  </ContextMenu>
                </Setter>
              </Style>
              <Style Selector="TreeViewItem.dropFolder">
                <Setter Property="Background" Value="{DynamicResource SystemAccentColor}" />
              </Style>
            </TreeView.Styles>
            <TreeView.ItemTemplate>
              <TreeDataTemplate ItemsSource="{Binding Children}">
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Padding="4,6" />
              </TreeDataTemplate>
            </TreeView.ItemTemplate>
          </TreeView>
        </Grid>
      </Border>
      <Grid Grid.Column="1" Margin="24,20" RowDefinitions="Auto,Auto,*" RowSpacing="14">
        <TextBlock Text="{Binding SelectedAreaName}" FontSize="27" FontWeight="SemiBold"
                   AutomationProperties.AutomationId="SelectedAreaHeading" />
        <TextBox x:Name="QuickAddBox" Grid.Row="1" PlaceholderText="Add an item and press Enter" AutomationProperties.AutomationId="QuickAddBox"
                 Text="{Binding QuickAddTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
          <TextBox.KeyBindings>
            <KeyBinding Gesture="Enter" Command="{Binding QuickAddCommand}" />
          </TextBox.KeyBindings>
        </TextBox>
        <Border Grid.Row="2" IsVisible="{Binding HasItemMoveError}" ZIndex="1"
                VerticalAlignment="Top" Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                Padding="8" CornerRadius="4">
          <TextBlock Text="{Binding ItemMoveError}" TextWrapping="Wrap"
                     AutomationProperties.AutomationId="ItemMoveError" />
        </Border>
        <ScrollViewer x:Name="ItemsScrollViewer" Grid.Row="2" HorizontalScrollBarVisibility="Disabled">
          <ScrollViewer.KeyBindings>
            <KeyBinding Gesture="Space" Command="{Binding ToggleSelectedCommand}" />
            <KeyBinding Gesture="Delete" Command="{Binding DeleteItemCommand}" />
          </ScrollViewer.KeyBindings>
          <!-- Open top-level items are cards, one section per priority (§8). Each grid row is as
               tall as its tallest card, and at least CardMinHeight, so about two rows fill the pane. -->
          <StackPanel Spacing="20" Margin="0,0,14,0">
            <ItemsControl ItemsSource="{Binding OpenGroups}" AutomationProperties.AutomationId="PriorityGroups">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Spacing="20" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Spacing="8">
                    <Border Classes="groupHeader" Padding="6,3" CornerRadius="4" HorizontalAlignment="Stretch"
                            AutomationProperties.AutomationId="PriorityGroupHeader" AutomationProperties.Name="{Binding Title}">
                      <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding CountLabel}" FontSize="12" Opacity="0.6" VerticalAlignment="Center" />
                      </StackPanel>
                    </Border>
                    <ItemsControl ItemsSource="{Binding Cards}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <views:CardGridPanel Columns="{Binding $parent[views:ProjectWorkspaceView].DataContext.CardColumns}"
                                               MinRowHeight="{Binding $parent[views:ProjectWorkspaceView].CardMinHeight}" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <views:ItemCardView />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Expander Header="{Binding CompletedLabel}" IsExpanded="{Binding IsCompletedExpanded, Mode=TwoWay}" AutomationProperties.AutomationId="CompletedItemsExpander"
                      IsVisible="{Binding HasCompletedItems}"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
              <ItemsControl ItemsSource="{Binding CompletedItems}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <views:CardGridPanel Columns="{Binding $parent[views:ProjectWorkspaceView].DataContext.CardColumns}" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <views:ItemCardView />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Expander>
          </StackPanel>
        </ScrollViewer>
      </Grid>
      <Border Grid.Column="2" BorderThickness="1,0,0,0"
              BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" Padding="16,20,16,16">
        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="DETAILS" FontSize="12" FontWeight="SemiBold" Opacity="0.6" VerticalAlignment="Center" />
            <Button Grid.Column="1" Classes="subtle" Padding="6,2"
                    IsVisible="{Binding HasEditor}" Command="{Binding ToggleSelectedCurrentCommand}"
                    ToolTip.Tip="The current item is shown when you click the tray icon"
                    AutomationProperties.AutomationId="EditorCurrentItemButton">
              <Panel>
                <TextBlock Text="☆ Set as current" IsVisible="{Binding !IsSelectedItemCurrent}" />
                <TextBlock Text="★ Current item" IsVisible="{Binding IsSelectedItemCurrent}"
                           Foreground="{DynamicResource SystemControlHighlightAccentBrush}" />
              </Panel>
            </Button>
          </Grid>
          <ScrollViewer x:Name="EditorScrollViewer" Grid.Row="1" AllowAutoHide="False" VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="8" Margin="0,0,20,0">
              <TextBlock Text="Select an item to see its details." IsVisible="{Binding !HasEditor}"
                         TextWrapping="Wrap" Opacity="0.7" />
              <StackPanel DataContext="{Binding Editor}"
                          IsVisible="{Binding $parent[UserControl].DataContext.HasEditor}" Spacing="8">
              <TextBlock Text="Title" />
              <TextBox x:Name="EditorTitleBox" Text="{Binding Title, Mode=TwoWay}" AutomationProperties.AutomationId="EditorTitleBox" />
              <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="2">
                <TextBlock Text="Description" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="Edit" Classes="subtle tab" Classes.activeTab="{Binding IsEditingDescription}"
                        Command="{Binding ShowEditCommand}" AutomationProperties.AutomationId="EditorDescriptionEditTab" />
                <Button Grid.Column="2" Content="Preview" Classes="subtle tab" Classes.activeTab="{Binding IsPreviewing}"
                        Command="{Binding ShowPreviewCommand}" AutomationProperties.AutomationId="EditorDescriptionPreviewTab" />
              </Grid>
              <TextBox Text="{Binding Description, Mode=TwoWay}" AcceptsReturn="True" MinHeight="80" AutomationProperties.AutomationId="EditorDescriptionBox"
                       TextWrapping="Wrap" IsVisible="{Binding IsEditingDescription}" />
              <Border IsVisible="{Binding IsPreviewing}" MinHeight="80" Padding="8,6" CornerRadius="4" BorderThickness="1"
                      BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                      AutomationProperties.AutomationId="EditorDescriptionPreview">
                <views:MarkdownView Blocks="{Binding PreviewBlocks}"
                                    LinkCommand="{Binding $parent[UserControl].DataContext.OpenLinkCommand}" />
              </Border>
              <TextBlock Text="Ticket number" />
              <TextBox Text="{Binding TicketNumber, Mode=TwoWay}" AutomationProperties.AutomationId="EditorTicketNumberBox" />
              <TextBlock Text="Type" />
              <TextBlock Text="{Binding ArchivedTypeName}" IsVisible="{Binding HasArchivedType}" Opacity="0.7" />
              <ComboBox ItemsSource="{Binding $parent[UserControl].DataContext.TypeOptions}" AutomationProperties.AutomationId="EditorTypeBox"
                        SelectedItem="{Binding SelectedTypeOption, Mode=TwoWay}"
                        DisplayMemberBinding="{Binding Name}" HorizontalAlignment="Stretch" />
              <TextBlock Text="Priority" />
              <TextBlock Text="{Binding ArchivedPriorityName}" IsVisible="{Binding HasArchivedPriority}" Opacity="0.7" />
              <ComboBox ItemsSource="{Binding $parent[UserControl].DataContext.PriorityOptions}" AutomationProperties.AutomationId="EditorPriorityBox"
                        SelectedItem="{Binding SelectedPriorityOption, Mode=TwoWay}"
                        DisplayMemberBinding="{Binding Name}" HorizontalAlignment="Stretch" />
              <TextBlock Text="Status" />
              <ComboBox ItemsSource="{Binding StatusOptions}" AutomationProperties.AutomationId="EditorStatusBox"
                        SelectedItem="{Binding SelectedStatusOption, Mode=TwoWay}"
                        DisplayMemberBinding="{Binding Name}" HorizontalAlignment="Stretch" />
              <TextBlock Text="Due date" />
              <Grid ColumnDefinitions="*,32" ColumnSpacing="6">
                <CalendarDatePicker SelectedDate="{Binding DueDatePickerDate, Mode=TwoWay}" AutomationProperties.AutomationId="EditorDueDatePicker"
                                    HorizontalAlignment="Stretch" />
                <Button Grid.Column="1" Content="✕" ToolTip.Tip="Clear due date" Classes="subtle icon" AutomationProperties.AutomationId="EditorClearDueDateButton"
                        Command="{Binding ClearDueDateCommand}" />
              </Grid>
              <TextBlock Text="Due time" />
              <Grid ColumnDefinitions="*,32" ColumnSpacing="6">
                <TimePicker SelectedTime="{Binding DueTimePickerTime, Mode=TwoWay}" HorizontalAlignment="Stretch" MinWidth="0" AutomationProperties.AutomationId="EditorDueTimePicker" />
                <Button Grid.Column="1" Content="✕" ToolTip.Tip="Clear due time" Classes="subtle icon" AutomationProperties.AutomationId="EditorClearDueTimeButton"
                        Command="{Binding ClearDueTimeCommand}" />
              </Grid>
              <TextBlock Text="Scheduled start" />
              <Grid ColumnDefinitions="*,32" RowDefinitions="Auto,Auto" ColumnSpacing="6" RowSpacing="4">
                <CalendarDatePicker SelectedDate="{Binding StartPickerDate, Mode=TwoWay}" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="EditorStartDatePicker" />
                <TimePicker Grid.Row="1" SelectedTime="{Binding StartPickerTime, Mode=TwoWay}" HorizontalAlignment="Stretch" MinWidth="0" AutomationProperties.AutomationId="EditorStartTimePicker" />
                <Button Grid.Column="1" Grid.RowSpan="2" Content="✕" ToolTip.Tip="Clear scheduled start"
                        Classes="subtle icon" VerticalAlignment="Center" Command="{Binding ClearStartCommand}" AutomationProperties.AutomationId="EditorClearStartButton" />
              </Grid>
              <TextBlock Text="Scheduled end" />
              <Grid ColumnDefinitions="*,32" RowDefinitions="Auto,Auto" ColumnSpacing="6" RowSpacing="4">
                <CalendarDatePicker SelectedDate="{Binding EndPickerDate, Mode=TwoWay}" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="EditorEndDatePicker" />
                <TimePicker Grid.Row="1" SelectedTime="{Binding EndPickerTime, Mode=TwoWay}" HorizontalAlignment="Stretch" MinWidth="0" AutomationProperties.AutomationId="EditorEndTimePicker" />
                <Button Grid.Column="1" Grid.RowSpan="2" Content="✕" ToolTip.Tip="Clear scheduled end"
                        Classes="subtle icon" VerticalAlignment="Center" Command="{Binding ClearEndCommand}" AutomationProperties.AutomationId="EditorClearEndButton" />
              </Grid>
              <views:ItemRecurrenceView />
              <views:ItemReminderView />
              <views:CustomFieldsView />
              <views:ItemLinksView />
              <TextBlock Text="Sub-items" FontWeight="SemiBold" Margin="0,12,0,0" />
              <ItemsControl ItemsSource="{Binding $parent[UserControl].DataContext.SelectedSubItems}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Classes="subtle" Command="{Binding SelectCommand}" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="EditorSubItemButton"
                            HorizontalContentAlignment="Left" Padding="6,4">
                      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <CheckBox IsChecked="{Binding IsComplete, Mode=OneWay}" IsHitTestVisible="False"
                                  Focusable="False" MinWidth="0" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Button Content="+ Add sub-item" Classes="subtle" HorizontalAlignment="Left" AutomationProperties.AutomationId="EditorAddSubItemButton"
                      Command="{Binding $parent[UserControl].DataContext.AddSubItemCommand}" />
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
          <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8"
                IsVisible="{Binding HasEditor}">
            <Button Content="Delete item" Classes="subtle danger" Command="{Binding DeleteItemCommand}" AutomationProperties.AutomationId="EditorDeleteButton" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
              <Button Content="Revert" Classes="subtle" Command="{Binding RevertCommand}" AutomationProperties.AutomationId="EditorRevertButton" />
              <Button Content="Save" Classes="accent" Command="{Binding SaveCommand}" AutomationProperties.AutomationId="EditorSaveButton" />
            </StackPanel>
          </Grid>
        </Grid>
      </Border>
    </Grid>
    <Border Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="16" Padding="14,8" CornerRadius="6"
            Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1"
            IsHitTestVisible="False" IsVisible="{Binding HasRecurrenceStatus}">
      <TextBlock Text="{Binding RecurrenceStatus}" AutomationProperties.AutomationId="WorkspaceRecurrenceStatus" />
    </Border>
    <Border Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="16" Padding="14,8" CornerRadius="6"
            Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1"
            IsHitTestVisible="False" IsVisible="{Binding Undo.HasStatus}">
      <TextBlock Text="{Binding Undo.Status}" TextWrapping="Wrap" AutomationProperties.AutomationId="WorkspaceUndoStatus" />
    </Border>
  </Grid>
</UserControl>
