<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TaskTracker.Presentation.ViewModels"
             x:Class="TaskTracker.App.Desktop.Views.ItemReminderView"
             x:DataType="vm:ItemEditorViewModel">
  <StackPanel Spacing="4" Margin="0,8,0,0">
    <TextBlock Text="Reminder" Classes="caption" />
    <ComboBox ItemsSource="{Binding ReminderChoices}" SelectedItem="{Binding SelectedReminder, Mode=TwoWay}"
              HorizontalAlignment="Stretch" AutomationProperties.Name="Reminder"
              AutomationProperties.AutomationId="EditorReminderChoice">
      <ComboBox.ItemTemplate>
        <DataTemplate x:DataType="vm:ReminderChoice">
          <TextBlock Text="{Binding Label}" />
        </DataTemplate>
      </ComboBox.ItemTemplate>
    </ComboBox>
  </StackPanel>
</UserControl>
