<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:TaskTracker.App.Desktop.Views"
             x:Class="TaskTracker.App.Desktop.Views.TodayBranchView"
             x:CompileBindings="False">
  <StackPanel>
    <Grid ColumnDefinitions="24,32,Auto,Auto,*" ColumnSpacing="5" Background="Transparent"
          Focusable="True" AutomationProperties.AutomationId="TodayItemRow" AutomationProperties.Name="{Binding Title}">
      <Grid.ContextMenu>
        <ContextMenu>
          <MenuItem Header="Open" Command="{Binding OpenCommand}" AutomationProperties.AutomationId="TodayOpenMenuItem" />
          <MenuItem Header="Push back one day" Command="{Binding PushBackCommand}"
                    ToolTip.Tip="{Binding PushBackReason}" ToolTip.ShowOnDisabled="True"
                    AutomationProperties.AutomationId="PushBackOneDayMenuItem" />
        </ContextMenu>
      </Grid.ContextMenu>
      <ToggleButton Content="{Binding ExpandLabel}" IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                    IsVisible="{Binding HasChildren}" Width="24" Padding="0"
                    AutomationProperties.AutomationId="TodayExpandButton" AutomationProperties.Name="Show or hide children" />
      <CheckBox Grid.Column="1" IsChecked="{Binding IsCompleted, Mode=OneWay}" Command="{Binding ReopenCommand}"
                VerticalAlignment="Center" AutomationProperties.AutomationId="TodayReopenCheckBox"
                AutomationProperties.Name="{Binding Title, StringFormat='Reopen {0}'}" />
      <Button Grid.Column="2" Classes="subtle" Content="{Binding Title}" Command="{Binding OpenCommand}"
              Opacity="{Binding Opacity}" AutomationProperties.AutomationId="TodayOpenItemButton" />
      <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Opacity="0.65">
        <TextBlock Text="{Binding Status}" AutomationProperties.AutomationId="TodayItemStatus"
                   IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <TextBlock Text="{Binding ChildCount}" IsVisible="{Binding ShowChildCount}"
                   AutomationProperties.AutomationId="TodayChildCount" />
      </StackPanel>
    </Grid>
    <ItemsControl ItemsSource="{Binding Children}" IsVisible="{Binding IsExpanded}" Margin="24,0,0,0">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <views:TodayBranchView />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</UserControl>
