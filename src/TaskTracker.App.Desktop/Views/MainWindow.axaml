<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:TaskTracker.App.Desktop.Views"
        xmlns:vm="using:TaskTracker.Presentation.ViewModels"
        x:Class="TaskTracker.App.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/app.ico"
        Title="{Binding Title}"
        Width="1200" Height="800" MinWidth="800" MinHeight="500">
    <Grid RowDefinitions="Auto,*">
      <Menu Background="{DynamicResource AppCardBackgroundBrush}" AutomationProperties.AutomationId="MainMenu">
        <MenuItem Header="_File" AutomationProperties.AutomationId="FileMenu">
          <MenuItem Header="Settings…" Command="{Binding SettingsCommand}"
                    AutomationProperties.AutomationId="AppSettingsMenuItem" />
          <MenuItem Header="Import JSON…" Command="{Binding HomePage.Transfer.ImportJsonCommand}"
                    IsVisible="{Binding HomePage.Transfer, Converter={x:Static ObjectConverters.IsNotNull}}"
                    IsEnabled="{Binding HomePage.Transfer.IsIdle}"
                    AutomationProperties.AutomationId="ImportJsonMenuItem" />
          <MenuItem Header="Export everything (JSON)…" Command="{Binding HomePage.Transfer.ExportAllCommand}"
                    IsVisible="{Binding HomePage.Transfer, Converter={x:Static ObjectConverters.IsNotNull}}"
                    IsEnabled="{Binding HomePage.Transfer.IsIdle}"
                    AutomationProperties.AutomationId="ExportAllMenuItem" />
        </MenuItem>
        <MenuItem Header="_Edit" AutomationProperties.AutomationId="EditMenu" IsVisible="{Binding Undo, Converter={x:Static ObjectConverters.IsNotNull}}">
          <MenuItem Header="{Binding Undo.UndoTooltip}" Command="{Binding Undo.UndoCommand}"
                    InputGesture="Ctrl+Z" AutomationProperties.AutomationId="UndoMenuItem" />
          <MenuItem Header="{Binding Undo.RedoTooltip}" Command="{Binding Undo.RedoCommand}"
                    InputGesture="Ctrl+Y" AutomationProperties.AutomationId="RedoMenuItem" />
        </MenuItem>
        <MenuItem Header="_Project" AutomationProperties.AutomationId="ProjectMenu" IsEnabled="{Binding HasProjectMenuActions}">
          <MenuItem Header="New project…" Command="{Binding HomePage.CreateCommand}"
                    IsVisible="{Binding HomePage, Converter={x:Static ObjectConverters.IsNotNull}}"
                    AutomationProperties.AutomationId="NewProjectMenuItem" />
          <MenuItem Header="Project settings…" Command="{Binding WorkspacePage.ProjectSettingsCommand}"
                    IsVisible="{Binding WorkspacePage, Converter={x:Static ObjectConverters.IsNotNull}}"
                    AutomationProperties.AutomationId="ProjectSettingsMenuItem" />
          <MenuItem Header="Import CSV into project…" Command="{Binding HomePage.Transfer.ImportCsvCommand}"
                    IsVisible="{Binding HomePage.Transfer, Converter={x:Static ObjectConverters.IsNotNull}}"
                    IsEnabled="{Binding HomePage.Transfer.IsIdle}"
                    AutomationProperties.AutomationId="ImportCsvMenuItem" />
          <MenuItem Header="Export project (JSON)…" Command="{Binding HomePage.Transfer.ExportProjectJsonCommand}"
                    IsVisible="{Binding HomePage.Transfer, Converter={x:Static ObjectConverters.IsNotNull}}"
                    IsEnabled="{Binding HomePage.Transfer.IsIdle}"
                    AutomationProperties.AutomationId="ExportProjectJsonMenuItem" />
          <MenuItem Header="Export project (CSV)…" Command="{Binding HomePage.Transfer.ExportProjectCsvCommand}"
                    IsVisible="{Binding HomePage.Transfer, Converter={x:Static ObjectConverters.IsNotNull}}"
                    IsEnabled="{Binding HomePage.Transfer.IsIdle}"
                    AutomationProperties.AutomationId="ExportProjectCsvMenuItem" />
        </MenuItem>
        <MenuItem Header="_View" AutomationProperties.AutomationId="ViewMenu">
          <MenuItem Header="Search" Command="{Binding SearchCommand}"
                    InputGesture="Ctrl+F" AutomationProperties.AutomationId="SearchMenuItem" />
          <MenuItem Header="Calendar" Command="{Binding CalendarCommand}"
                    InputGesture="Ctrl+Shift+C" AutomationProperties.AutomationId="CalendarMenuItem" />
          <MenuItem Header="Today" Command="{Binding TodayCommand}"
                    InputGesture="Ctrl+Shift+D" AutomationProperties.AutomationId="TodayMenuItem" />
          <MenuItem Header="Tickets" Command="{Binding TicketsCommand}"
                    InputGesture="Ctrl+Shift+K" AutomationProperties.AutomationId="TicketsMenuItem" />
          <MenuItem Header="Trash" Command="{Binding TrashCommand}"
                    InputGesture="Ctrl+Shift+T" AutomationProperties.AutomationId="TrashMenuItem" />
          <MenuItem Header="{Binding Reminders.BellName}" Command="{Binding Reminders.ToggleCommand}"
                    IsVisible="{Binding Reminders, Converter={x:Static ObjectConverters.IsNotNull}}"
                    InputGesture="Ctrl+Shift+R" AutomationProperties.AutomationId="RemindersMenuItem" />
        </MenuItem>
      </Menu>
      <ContentControl Grid.Row="1" Content="{Binding CurrentPage}" />
      <Border Grid.Row="1" IsVisible="{Binding Reminders.IsOpen, FallbackValue=False}"
              HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,12,0">
        <views:RemindersView DataContext="{Binding Reminders}" />
      </Border>
    </Grid>
</Window>
