<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TaskTracker.Presentation.ViewModels"
             x:Class="TaskTracker.App.Desktop.Views.CurrentItemCardView"
             x:DataType="vm:CurrentItemCardViewModel"
             AutomationProperties.AutomationId="CurrentItemCard">
  <Border Classes="card" Width="320" Padding="16">
    <StackPanel Spacing="8">
      <TextBlock Text="CURRENT ITEM" FontSize="11" FontWeight="SemiBold" Opacity="0.6" />
      <StackPanel Spacing="8" IsVisible="{Binding IsEmpty}">
        <TextBlock Text="No current item." FontWeight="SemiBold" />
        <TextBlock Text="Right-click an item in Task Tracker and choose Set as current item."
                   TextWrapping="Wrap" Opacity="0.7" />
      </StackPanel>
      <StackPanel Spacing="8" IsVisible="{Binding HasItem}">
        <TextBlock Text="{Binding Title}" Classes="cardTitle" TextWrapping="Wrap"
                   AutomationProperties.AutomationId="CurrentItemTitle" />
        <TextBlock Text="{Binding AreaPath}" FontSize="12" Opacity="0.7" TextTrimming="CharacterEllipsis"
                   ToolTip.Tip="{Binding AreaPath}" />
        <WrapPanel ItemSpacing="6" LineSpacing="4">
          <Border Classes="statusChip" IsVisible="{Binding IsCompleted}">
            <TextBlock Text="Completed" />
          </Border>
          <Border Classes="statusChip" IsVisible="{Binding HasStatus}">
            <TextBlock Text="{Binding StatusName}" TextTrimming="CharacterEllipsis" />
          </Border>
          <Border Classes="statusChip" IsVisible="{Binding HasPriority}">
            <TextBlock Text="{Binding PriorityName}" TextTrimming="CharacterEllipsis" />
          </Border>
          <TextBlock Text="{Binding DueText}" FontSize="12" IsVisible="{Binding HasDue}" VerticalAlignment="Center" />
        </WrapPanel>
        <SelectableTextBlock Text="{Binding Description}" IsVisible="{Binding HasDescription}" TextWrapping="Wrap"
                             MaxLines="6" TextTrimming="CharacterEllipsis" FontSize="12" Opacity="0.85" />
        <Button Content="Open in Task Tracker" Classes="accent" HorizontalAlignment="Right" Command="{Binding OpenCommand}"
                AutomationProperties.AutomationId="CurrentItemOpenButton" />
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
