<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:TaskTracker.App.Desktop.Views"
             x:Class="TaskTracker.App.Desktop.Views.AppSettingsView"
             x:CompileBindings="False">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="32,24" Spacing="16" MaxWidth="880" HorizontalAlignment="Stretch">
      <Button Content="← Back" Command="{Binding BackCommand}" Classes="subtle" HorizontalAlignment="Left" AutomationProperties.AutomationId="AppSettingsBackButton" />
      <TextBlock Text="App Settings" FontSize="30" FontWeight="SemiBold" />

      <Border Classes="card">
        <StackPanel Spacing="14">
          <TextBlock Text="Global defaults" Classes="cardTitle" />
          <CheckBox Content="Automatically complete parents when all sub-items are complete"
                    IsChecked="{Binding AutoCompleteParents, Mode=TwoWay}" AutomationProperties.AutomationId="GlobalAutoCompleteCheckBox" />
          <Grid ColumnDefinitions="220,120,110" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
            <TextBlock Grid.Row="0" Text="Yellow urgency threshold" VerticalAlignment="Center" />
            <NumericUpDown Grid.Row="0" Grid.Column="1" Value="{Binding YellowAmount, Mode=TwoWay}" Minimum="0" AutomationProperties.AutomationId="GlobalYellowThresholdBox" />
            <ComboBox Grid.Row="0" Grid.Column="2" ItemsSource="{Binding DurationUnits}"
                      SelectedItem="{Binding YellowUnit, Mode=TwoWay}" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="GlobalYellowUnitBox" />
            <TextBlock Grid.Row="1" Text="Red urgency threshold" VerticalAlignment="Center" />
            <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding RedAmount, Mode=TwoWay}" Minimum="0" AutomationProperties.AutomationId="GlobalRedThresholdBox" />
            <ComboBox Grid.Row="1" Grid.Column="2" ItemsSource="{Binding DurationUnits}"
                      SelectedItem="{Binding RedUnit, Mode=TwoWay}" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="GlobalRedUnitBox" />
          </Grid>
          <Grid ColumnDefinitions="220,120" ColumnSpacing="10">
            <TextBlock Text="Cards per row" VerticalAlignment="Center" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding CardColumnChoices}" SelectedItem="{Binding CardColumns, Mode=TwoWay}"
                      HorizontalAlignment="Stretch" AutomationProperties.Name="Cards per row"
                      AutomationProperties.AutomationId="GlobalCardColumnsBox" />
          </Grid>
          <StackPanel DataContext="{Binding Reminders}" Spacing="8">
            <TextBlock Text="Reminders" Classes="cardTitle" />
            <CheckBox Content="Enable reminders" IsChecked="{Binding Enabled, Mode=TwoWay}"
                      AutomationProperties.AutomationId="GlobalRemindersEnabled" />
            <Grid ColumnDefinitions="220,190" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="8">
              <TextBlock Text="Default offset" VerticalAlignment="Center" />
              <ComboBox Grid.Column="1" ItemsSource="{Binding OffsetChoices}" DisplayMemberBinding="{Binding Label}"
                        SelectedItem="{Binding SelectedOffset, Mode=TwoWay}" HorizontalAlignment="Stretch"
                        AutomationProperties.Name="Default offset" AutomationProperties.AutomationId="GlobalReminderOffset" />
              <TextBlock Grid.Row="1" Text="Date-only reminder time" VerticalAlignment="Center" />
              <TimePicker Grid.Row="1" Grid.Column="1" SelectedTime="{Binding DateOnlyTime, Mode=TwoWay}"
                          HorizontalAlignment="Stretch" MinWidth="0"
                          AutomationProperties.Name="Date-only reminder time" AutomationProperties.AutomationId="GlobalDateOnlyReminderTime" />
            </Grid>
            <CheckBox Content="Keep running in tray when the window closes" IsChecked="{Binding KeepRunningInTray, Mode=TwoWay}"
                      AutomationProperties.AutomationId="KeepRunningInTray" />
            <!-- Saved with the page's defaults, so it binds to the page rather than to Reminders. -->
            <CheckBox Content="Start Task Tracker when I sign in"
                      IsChecked="{Binding $parent[views:AppSettingsView].DataContext.StartWithSystem, Mode=TwoWay}"
                      IsVisible="{Binding $parent[views:AppSettingsView].DataContext.IsStartWithSystemAvailable}"
                      AutomationProperties.AutomationId="StartWithSystem" />
          </StackPanel>
          <TextBlock Text="{Binding Error}" TextWrapping="Wrap"
                     IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}"
                     Foreground="{DynamicResource AppDangerBrush}" />
          <Button Content="Save defaults" Classes="accent" Command="{Binding SaveCommand}"
                  IsEnabled="{Binding CanSave}" HorizontalAlignment="Left" AutomationProperties.AutomationId="AppSettingsSaveButton" />
        </StackPanel>
      </Border>

      <Border Classes="card" IsVisible="{Binding About, Converter={x:Static ObjectConverters.IsNotNull}}">
        <StackPanel Spacing="10">
          <TextBlock Text="About" Classes="cardTitle" />
          <TextBlock Text="{Binding About}" AutomationProperties.AutomationId="AboutVersion" />
          <StackPanel DataContext="{Binding Updates}" Spacing="10">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Button Content="Check for updates" Command="{Binding CheckCommand}"
                      AutomationProperties.AutomationId="CheckForUpdatesButton" />
              <Button Content="Download" Classes="accent" Command="{Binding DownloadCommand}"
                      IsVisible="{Binding IsUpdateAvailable}" AutomationProperties.AutomationId="DownloadUpdateButton" />
              <Button Content="Restart to update" Classes="accent" Command="{Binding RestartCommand}"
                      IsVisible="{Binding IsReadyToRestart}" AutomationProperties.AutomationId="RestartToUpdateButton" />
            </StackPanel>
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap"
                       IsVisible="{Binding Status, Converter={x:Static ObjectConverters.IsNotNull}}"
                       AutomationProperties.AutomationId="UpdateStatus" />
          </StackPanel>
        </StackPanel>
      </Border>

      <WrapPanel Orientation="Horizontal">
        <views:LookupListView DataContext="{Binding ItemTypes}" Width="432" Margin="0,0,16,16" />
        <views:LookupListView DataContext="{Binding PriorityLevels}" Width="432" Margin="0,0,16,16" />
        <views:LookupListView DataContext="{Binding Statuses}" Width="432" Margin="0,0,0,16"
                              AutomationProperties.AutomationId="StatusLookupList" />
      </WrapPanel>
      <views:FieldManagerView DataContext="{Binding CustomFields}" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
