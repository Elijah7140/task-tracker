<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TaskTracker.App.Desktop.Views.TrashView"
             x:CompileBindings="False">
  <Grid x:Name="TrashRoot" RowDefinitions="Auto,Auto,*" Margin="32" RowSpacing="16" Focusable="True">
    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
      <Button Content="← Back" Command="{Binding BackCommand}" AutomationProperties.AutomationId="TrashBackButton" />
      <TextBlock Grid.Column="1" Text="Trash" FontSize="30" FontWeight="SemiBold" VerticalAlignment="Center" />
      <ComboBox Grid.Column="2" Width="150" ItemsSource="{Binding ScopeOptions}"
                SelectedItem="{Binding SelectedScope, Mode=TwoWay}"
                AutomationProperties.AutomationId="TrashScopeComboBox" />
      <Button Grid.Column="3" Content="Empty trash" Command="{Binding EmptyCommand}"
              AutomationProperties.AutomationId="EmptyTrashButton" />
    </Grid>
    <TextBlock Grid.Row="1" Text="{Binding Error}" IsVisible="{Binding HasError}"
               Foreground="{DynamicResource AppDangerBrush}" TextWrapping="Wrap"
               AutomationProperties.AutomationId="TrashErrorText" />
    <ScrollViewer Grid.Row="2">
      <Panel>
        <TextBlock Text="The trash is empty." IsVisible="{Binding ShowEmpty}" FontSize="16" Opacity="0.7"
                   Margin="0,32" HorizontalAlignment="Center" AutomationProperties.AutomationId="TrashEmptyText" />
        <ItemsControl ItemsSource="{Binding Batches}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border BorderThickness="1" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                      CornerRadius="10" Padding="20,16" Margin="0,0,0,12"
                      AutomationProperties.AutomationId="TrashBatchRow" AutomationProperties.AccessibilityView="Content"
                      AutomationProperties.Name="{Binding Title}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                  <StackPanel Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding KindLabel}" Opacity="0.7" VerticalAlignment="Bottom" />
                    </StackPanel>
                    <TextBlock Text="{Binding Location, StringFormat='Was in: {0}'}" Opacity="0.75"
                               TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal" Spacing="18">
                      <TextBlock Text="{Binding DeletedText, StringFormat='Deleted {0}'}" Opacity="0.75" />
                      <TextBlock Text="{Binding ContentsText}" Opacity="0.75" />
                    </StackPanel>
                    <TextBlock Text="{Binding RestoreBlockedReason}" IsVisible="{Binding HasRestoreBlockedReason}"
                               Foreground="{DynamicResource AppDangerBrush}" TextWrapping="Wrap"
                               AutomationProperties.AutomationId="TrashRestoreBlockedReason" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Content="Restore" Classes="accent" IsEnabled="{Binding CanRestore}"
                            Command="{Binding $parent[UserControl].DataContext.RestoreCommand}"
                            CommandParameter="{Binding}"
                            AutomationProperties.AutomationId="RestoreBatchButton" />
                    <Button Content="Delete permanently" Classes="subtle"
                            Command="{Binding $parent[UserControl].DataContext.PurgeCommand}"
                            CommandParameter="{Binding}"
                            AutomationProperties.AutomationId="PurgeBatchButton" />
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Panel>
    </ScrollViewer>
  </Grid>
</UserControl>
