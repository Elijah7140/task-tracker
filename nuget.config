<?xml version="1.0" encoding="utf-8"?>
<!--
  Restores this repository from nuget.org only, whatever feeds the machine has configured.
  Without this, a second machine-wide source (such as a work feed) triggers NU1507
  under central package management, which TreatWarningsAsErrors turns into a build failure.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
